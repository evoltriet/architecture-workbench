{
  "name": "architecture-workbench",
  "version": "0.2.0",
  "description": "Agent-ready architecture-as-code framework for humans and LLM agents to collaboratively discover, design, review, and publish software architectures.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Triet Pham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evoltriet/architecture-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/evoltriet/architecture-workbench/issues"
  },
  "homepage": "https://github.com/evoltriet/architecture-workbench#readme",
  "keywords": [
    "architecture-as-code",
    "software-architecture",
    "llm-agents",
    "mcp",
    "drawio",
    "docx"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "archwork": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "prompts",
    "integrations",
    "docs",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "archwork": "tsx src/cli.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm cli:verify && pnpm mcp:verify",
    "example:build": "tsx src/cli.ts build --config examples/service-fulfillment/architecture.yaml",
    "example:validate": "tsx src/cli.ts validate --config examples/service-fulfillment/architecture.yaml --strict",
    "example:review": "tsx src/cli.ts review --config examples/service-fulfillment/architecture.yaml",
    "example:diagrams": "tsx src/cli.ts diagrams verify --config examples/service-fulfillment/architecture.yaml",
    "example:context": "tsx src/cli.ts context --config examples/service-fulfillment/architecture.yaml --format json",
    "example:status": "tsx src/cli.ts status --config examples/service-fulfillment/architecture.yaml --format json",
    "assets:generate": "tsx scripts/generate-starter-assets.ts",
    "cli:verify": "tsx scripts/verify-cli-json.ts",
    "mcp:verify": "tsx scripts/verify-mcp.ts",
    "pack:verify": "tsx scripts/verify-package.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "^14.0.0",
    "docx": "^9.5.1",
    "fast-xml-parser": "^5.2.5",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
